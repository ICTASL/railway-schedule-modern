# Copy to /etc/railway-schedule-modern.env on the app server (chmod 640, owned by root:slr).
# Never commit the real file — this is a template only.

DATABASE_URL=mysql://slr_search:CHANGE_ME@192.168.243.89:3306/railway_central
DATABASE_POOL_SIZE=5
DATABASE_QUERY_TIMEOUT_MS=8000
INCLUDE_CANCELED_TRAINS=false
# The single quotes around 'self' must be literal characters in the CSP header value, not shell
# quoting — wrap the whole thing in double quotes so systemd's EnvironmentFile parser strips only
# the outer pair and leaves 'self' intact.
FRAME_ANCESTORS="'self' https://cp.lankagate.gov.lk"

# Next.js listens on 3000 by default; only change this if the Apache ProxyPass target differs.
PORT=3000
