# MySQL connection for the railway schedule database.
# In production use a dedicated READ-ONLY account (see db/readonly-user.sql), not root.
DATABASE_URL=mysql://slr_search:CHANGE_ME@localhost:3306/railway

# Optional tuning
DATABASE_POOL_SIZE=5
DATABASE_QUERY_TIMEOUT_MS=8000

# Space-separated origins allowed to embed this app in an iframe (CSP frame-ancestors).
# The legacy app was embedded in the Lanka Gate country portal.
FRAME_ANCESTORS='self' https://cp.lankagate.gov.lk

# Public search shows trains the CMS marks RUN. Set to true to also include CANCELED ones
# (useful for checking data; the CMS marks expired special trains CANCELED too).
INCLUDE_CANCELED_TRAINS=false
